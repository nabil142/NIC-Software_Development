# Production Environment Variables
# PORT will be set automatically by the deployment platform (Render, Railway, etc.)
PORT=8080
NODE_ENV=production

# REPLACE with your production database connection URL
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"

# REPLACE with a strong random string in your deployment environment settings
JWT_SECRET="replace-with-a-very-long-secure-random-secret-key"

# REPLACE with your production Google Gemini API key
GEMINI_API_KEY="your-gemini-api-key-here"
